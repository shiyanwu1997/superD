# ===== 必填 =====
SESSION_SECRET=请生成一个随机字符串
JWT_SECRET=请生成另一个随机字符串
ENCRYPTION_KEY=请生成一个32字节的密钥

# ===== 存储配置 =====
# 默认 SQLite（无需配置，开箱即用）
STORAGE_TYPE=sqlite

# MySQL 模式（取消注释并填写）
# STORAGE_TYPE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的MySQL密码
# MYSQL_DATABASE=supervisor

# ===== 可选 =====
# PORT=3000
# LOG_LEVEL=info
